public class Main {
    public static void main(String[] args) {
        String s = "abcd";
        boolean[] seen = new boolean[26];
        for (char c : s.toCharArray())
            if (c >= 'a' && c <= 'z') seen[c - 'a'] = true;
        for (int i = 0; i < 26; i++)
            if (!seen[i]) {
                System.out.println((char)(i + 'a'));
                return;
            }
        System.out.println("All letters present");
    }
}
