import java.util.*;

public class SetBits {
    public static void main(String[] args) {
        int n = 15; // 15 = 00001111
        int count = 0;
        while (n > 0) {
            if ((n & 1) == 1) {
                count++;
            }
            n = n >> 1; // Right shift the number by 1
        }
        System.out.println("Number of set bits: " + count);
        
    }
}
